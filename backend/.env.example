# คัดลอกเป็น .env แล้วแก้ค่า  (อย่า commit ไฟล์ .env ขึ้น Git)
PORT=3000

# --- Amazon RDS (MySQL) ---
DB_HOST=inventory-db.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=change_me
DB_NAME=inventory_db

# --- AWS ---
# บน EC2 ไม่ต้องใส่ Access Key: โค้ดใช้สิทธิ์จาก Instance Profile (LabInstanceProfile) อัตโนมัติ
AWS_REGION=us-east-1
S3_BUCKET=your-unique-inventory-bucket
# เว้นว่างได้ ถ้ายังไม่ได้สร้าง SNS Topic (ระบบจะข้ามการส่งแจ้งเตือน)
SNS_TOPIC_ARN=

# --- Auth ---
# สร้างด้วย: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h
